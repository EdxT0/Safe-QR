# Azure CLI local state
.azure/
**/.azure/

# Azure Functions local settings
local.settings.json
**/local.settings.json

# Azure publish profiles
*.pubxml
*.pubxml.user
**/Properties/PublishProfiles/*.pubxml
**/Properties/PublishProfiles/*.pubxml.user

# Azure deployment/config files that may contain secrets
azureProfile.json
**/azureProfile.json
.azureProfile
**/.azureProfile

# Azure service principal / credentials files
azureauth.json
**/azureauth.json
azure-credentials.json
**/azure-credentials.json
service-principal.json
**/service-principal.json
sp.json
**/sp.json

# Azure storage / hosting config
storage-account-key.json
**/storage-account-key.json
connectionstrings.json
**/connectionstrings.json

# Azure Static Web Apps local config
swa-cli.config.json
**/swa-cli.config.json

# Allow safe examples
!**/local.settings.example.json
!**/azure-credentials.example.json
!**/service-principal.example.json
!**/connectionstrings.example.json
!**/swa-cli.config.example.json


