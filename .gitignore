
# ============================================================
# 1. Environment files / Secret configuration
# ============================================================

# General env files
.env
.env.*
*.env

# Allow example env files to be committed
!.env.example
!.env.sample
!.env.template

# Local frontend/backend environment variants
**/.env
**/.env.*
**/*.env

# Do not ignore example env files
!**/.env.example
!**/.env.sample
!**/.env.template


# ============================================================
# 2. ASP.NET Core appsettings files
# ============================================================
# These often contain database connection strings, JWT secrets,
# Azure Storage keys, SMTP credentials, API keys, etc.
#
# Recommended:
# - Commit appsettings.example.json
# - Keep real appsettings locally only
# ============================================================

**/appsettings.Local.json
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Staging.json
**/appsettings.Test.json
**/appsettings.*.json

# Optional stricter rule:
# Uncomment this if you want to block ALL real appsettings files.
# Then only commit appsettings.example.json.
#
# **/appsettings.json

# Allow safe examples/templates
!**/appsettings.example.json
!**/appsettings.sample.json
!**/appsettings.template.json


# ============================================================
# 3. ASP.NET Core launch settings
# ============================================================
# launchSettings.json can contain environment variables,
# connection strings, local URLs, ports, secrets, etc.
# ============================================================

**/Properties/launchSettings.json
!**/Properties/launchSettings.example.json


# ============================================================
# 4. .NET User Secrets / Local secret stores
# ============================================================

secrets.json
**/secrets.json
**/usersecrets.json
**/UserSecrets/
**/.microsoft/usersecrets/
**/Microsoft/UserSecrets/


